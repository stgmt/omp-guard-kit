{
  "name": "omp-guard-kit",
  "version": "0.22.1",
  "description": "Composable Pi and OMP guardrails with deterministic root-artifact protection.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "omp",
    "guardrails",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stgmt/omp-guard-kit.git"
  },
  "homepage": "https://github.com/stgmt/omp-guard-kit",
  "bugs": {
    "url": "https://github.com/stgmt/omp-guard-kit/issues"
  },
  "engines": {
    "omp": ">=18.0.10"
  },
  "pi": {
    "extensions": [
      "./extensions/path-access/index.ts",
      "./extensions/guardrails/index.ts",
      "./extensions/permission-gate/index.ts",
      "./extensions/herdr/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "extensions",
    "dist",
    ".omp-plugin",
    "README.md",
    "schema.json",
    "!src/**/*.test.ts",
    "!extensions/**/*.test.ts"
  ],
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.19.1",
    "@aliou/sh": "^0.2.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.8.1",
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.27.11",
    "@earendil-works/pi-coding-agent": "0.79.6",
    "@earendil-works/pi-tui": "0.79.6",
    "@golevelup/ts-vitest": "^4.0.0",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^25.0.10",
    "husky": "^9.1.7",
    "memfs": "^4.57.2",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "build": "bun build extensions/omp.ts --outfile dist/extension.js --target bun --format esm --minify",
    "typecheck": "tsc --noEmit",
    "gen:schema": "pi-settings-schema -p src/shared/config/types.ts -t GuardrailsConfig -o schema.json --version 0.22.1",
    "check:schema": "pi-settings-schema -p src/shared/config/types.ts -t GuardrailsConfig -o schema.json --version 0.22.1 --check",
    "test": "vitest run",
    "test:mutation": "vitest run src/shared/config/loader.mutation.test.ts tests/root-artifacts.mutation.test.ts",
    "test:e2e": "bun tests/omp-e2e.ts",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome check --write",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "gh workflow run Publish --ref main"
  },
  "packageManager": "pnpm@10.26.1",
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
